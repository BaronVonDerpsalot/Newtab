# Optional build-time configuration. Copy to `.env` to override defaults.
# All values fall back to the originals baked into src/config.js if unset.
#
# No password or app-token here: those are server-side secrets on the `auth`
# edge function (APP_PASSWORD / APP_TOKEN), not client build config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USER_ID=
